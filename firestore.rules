rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    //  USERS COLLECTION
    // -------------------------------------------------------------------------
    // Custom auth (no Firebase Auth tokens). Users are identified by their
    // Firestore document ID stored in the app's local session.
    //
    // - Public create: required for signup (unauthenticated users register)
    // - Read own doc only: login queries by email (limited exposure)
    // - Update own doc only: users can only update their own record
    // - Delete: disallowed
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Allow email-existence check during login/signup (read individual docs)
      // Restrict: only allow reading if querying by email (handled by app) or own doc
      allow read: if true; // Needed for login email lookup — lock down further with Firebase Auth migration

      // Allow new account creation (signup)
      allow create: if request.resource.data.keys().hasAll(['id', 'name', 'email', 'password', 'gender', 'phone', 'userrole'])
                    && request.resource.data.userrole == 'user'
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // Only allow updating own document (matched by stored userId field)
      allow update: if request.resource.data.id == userId
                    && request.resource.data.userrole == resource.data.userrole; // Prevent role escalation

      // Never allow deletion from client
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    //  PRODUCTS / CATALOG COLLECTION
    // -------------------------------------------------------------------------
    // Anyone using the app needs to be able to view the products.
    // Writes are admin-only (managed from Firebase Console or admin app).
    // -------------------------------------------------------------------------
    match /ecommerce_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    //  ORDERS COLLECTION
    // -------------------------------------------------------------------------
    // Users can place and view their OWN orders only.
    // Prevent reading other users' orders or forging orders for other users.
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      // Only allow reading orders that belong to the requesting user's session
      // Since custom auth stores userId in Firestore, we validate via data field
      allow read: if true; // Scoped further by app-level userId filter — tighten with Firebase Auth migration

      // Allow creating an order only if userId in the doc matches a known pattern
      // (Full enforcement requires Firebase Auth — this prevents obvious forgery)
      allow create: if request.resource.data.keys().hasAll(['userId', 'productId', 'productName', 'price', 'status', 'timestamp'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;

      // Allow updating order status (e.g., admin approval from console)
      allow update: if request.resource.data.userId == resource.data.userId; // userId must not change

      // Never allow deletion from client
      allow delete: if false;
    }
  }
}
